<?xml version="1.0"?>
<!--
  A.R.M.S. SITL world (Gazebo Harmonic)
  - 드론(arms_drone)은 PX4가 airframe 4021로 직접 스폰 → 여기 include 안 함
  - 센서 시스템 플러그인(IMU/baro/airspeed/mag/navsat) 포함 → arm 가능
  - target_drone : 표적 드론 (referee가 set_pose로 비행 + 명중 연출)
-->
<sdf version="1.9">
  <world name="arms_sitl">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 지구 중력/자기장/위치 설정 (PX4가 EKF2에서 사용) -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397742</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>488.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- 핵심 시스템 플러그인 -->
    <plugin filename="gz-sim-physics-system"            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"  name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"      name="gz::sim::systems::UserCommands"/>

    <!-- 비행 센서 플러그인 (이게 빠지면 PX4가 Accel/Gyro/baro/mag missing 으로 arm 거부) -->
    <plugin filename="gz-sim-imu-system"          name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system"    name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system"       name="gz::sim::systems::NavSat"/>

    <!-- 하늘 배경 (카메라가 위를 보므로 균일한 하늘색이 검출에 유리) -->
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.6 0.78 0.95 1</background>
      <sky></sky>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 표적 드론 (referee가 set_pose로 비행). 시작 고도 12m -->
    <model name="target_drone">
      <static>false</static>
      <pose>0 0 12 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz></inertia>
        </inertial>
        <!-- x500_base 동체 메시 (시각적 표적용, 플러그인 없음) -->
        <visual name="body">
          <pose>0 0 0.1 -1.5708 0 0.7854</pose>
          <geometry>
            <mesh>
              <scale>0.003 0.003 0.003</scale>
              <uri>model://x500_base/meshes/ver_ksh_assembly.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.1 0.35 0.1 1</ambient>
            <diffuse>0.15 0.55 0.15 1</diffuse>
            <specular>0.2 0.3 0.2 1</specular>
          </material>
        </visual>
        <!-- 프로펠러 (CCW) -->
        <visual name="prop_0">
          <pose>0.175 -0.175 0.06 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://x500_base/meshes/1345_prop_ccw.stl</uri>
            </mesh>
          </geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="prop_1">
          <pose>-0.175 0.175 0.06 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://x500_base/meshes/1345_prop_ccw.stl</uri>
            </mesh>
          </geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- 프로펠러 (CW) -->
        <visual name="prop_2">
          <pose>0.175 0.175 0.06 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://x500_base/meshes/1345_prop_cw.stl</uri>
            </mesh>
          </geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="prop_3">
          <pose>-0.175 -0.175 0.06 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://x500_base/meshes/1345_prop_cw.stl</uri>
            </mesh>
          </geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>


  </world>
</sdf>
