<?xml version="1.0"?>
<!--
  A.R.M.S. SITL world (Gazebo Harmonic)
  - 드론(arms_drone)은 PX4가 airframe 4021로 직접 스폰 → 여기 include 안 함
  - 센서 시스템 플러그인(IMU/baro/airspeed/mag/navsat) 포함 → arm 가능
  - target_ball : 날아다니는 표적 (모델명 유지, 비주얼=x500 드론 외형). referee가 set_pose로 비행 + 명중 연출
-->
<sdf version="1.9">
  <world name="arms_sitl">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 지구 중력/자기장/위치 설정 (PX4가 EKF2에서 사용) -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397742</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>488.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- 핵심 시스템 플러그인 -->
    <plugin filename="gz-sim-physics-system"            name="gz::sim::systems::Physics"/>
    <!-- 표적 접촉 센서를 살리는 시스템. 이게 없으면 <sensor type="contact"> 는
         에러 없이 그냥 무시되고 토픽이 아예 안 생긴다. -->
    <plugin filename="gz-sim-contact-system"            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"  name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"      name="gz::sim::systems::UserCommands"/>

    <!-- 비행 센서 플러그인 (이게 빠지면 PX4가 Accel/Gyro/baro/mag missing 으로 arm 거부) -->
    <plugin filename="gz-sim-imu-system"          name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system"    name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system"       name="gz::sim::systems::NavSat"/>

    <!-- 하늘 배경 (카메라가 위를 보므로 균일한 하늘색이 검출에 유리) -->
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.6 0.78 0.95 1</background>
      <sky></sky>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 날아다니는 풍선 (referee가 움직임). 시작 고도 12m -->
    <!-- 표적 2종: referee가 UI 선택(target 파라미터)에 따라 하나만 비행시키고 나머진 HIDE_Z(지하)로 숨김.
         둘 다 z=-100(숨김)으로 스폰. 명중은 거리기반이라 어느 쪽이든 무손상. -->

    <!-- 표적 A: 풍선 (빨간 구) — 기본 -->
    <model name="target_ball">
      <static>false</static>
      <pose>0 0 -100 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>1.0</radius></sphere></geometry>
        </collision>
        <!-- 실제 접촉 판정. referee 가 이 토픽을 구독해 명중을 보고한다
             (거리 임계값 방식은 폐기: hit_radius 는 임의 상수였다). -->
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact>
            <collision>collision</collision>
          </contact>
        </sensor>
        <visual name="visual">
          <geometry><sphere><radius>1.0</radius></sphere></geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 표적 B: 적 드론 (PX4 x500 외형, model://x500_base 메시 참조).
         이름에 'drone'/'x500' 안 넣음 → referee 자기드론(arms_drone) 식별과 안 겹침. -->
    <model name="target_uav">
      <static>false</static>
      <pose>0 0 -100 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>1.0</radius></sphere></geometry>
        </collision>
        <!-- 풍선 표적과 같은 접촉 센서. 시각적으로는 x500 이지만 충돌 형상은
             반경 1.0 구 하나라, 접촉 판정 기준은 두 표적이 동일하다. -->
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact>
            <collision>collision</collision>
          </contact>
        </sensor>
        <visual name="drone_frame">
          <pose>0 0 0.025 0 0 3.141592654</pose>
          <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/NXP-HGD-CF.dae</uri></mesh></geometry>
        </visual>
        <visual name="drone_motor_0">
          <pose>0.174 0.174 0.032 0 0 -0.45</pose>
          <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        </visual>
        <visual name="drone_motor_1">
          <pose>-0.174 0.174 0.032 0 0 -0.45</pose>
          <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        </visual>
        <visual name="drone_motor_2">
          <pose>0.174 -0.174 0.032 0 0 -0.45</pose>
          <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        </visual>
        <visual name="drone_motor_3">
          <pose>-0.174 -0.174 0.032 0 0 -0.45</pose>
          <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        </visual>
        <!-- 프로펠러 (정적): 로터링크pose + prop센터링offset 합성. ccw=0,1 / cw=2,3 -->
        <visual name="drone_prop_0">
          <pose>0.152 -0.32038 0.044 0 0 0</pose>
          <geometry><mesh><scale>0.846 0.846 0.846</scale><uri>model://x500_base/meshes/1345_prop_ccw.stl</uri></mesh></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="drone_prop_1">
          <pose>-0.196 0.02762 0.044 0 0 0</pose>
          <geometry><mesh><scale>0.846 0.846 0.846</scale><uri>model://x500_base/meshes/1345_prop_ccw.stl</uri></mesh></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="drone_prop_2">
          <pose>0.152 0.02762 0.044 0 0 0</pose>
          <geometry><mesh><scale>0.846 0.846 0.846</scale><uri>model://x500_base/meshes/1345_prop_cw.stl</uri></mesh></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="drone_prop_3">
          <pose>-0.196 -0.32038 0.044 0 0 0</pose>
          <geometry><mesh><scale>0.846 0.846 0.846</scale><uri>model://x500_base/meshes/1345_prop_cw.stl</uri></mesh></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>


  </world>
</sdf>
