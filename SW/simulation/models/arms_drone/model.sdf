<?xml version="1.0"?>
<!--
  arms_drone model for Gazebo Harmonic (SDF 1.9)
  PX4 내장 x500을 그대로 include하고, ARMS 전용 센서/외형만 추가.

  추가 요소:
    1. arms_body_visual    — 커스텀 동체 메시 (ver_ksh_assembly.stl)
    2. upward_camera_link  — 위쪽 카메라 센서 (+Z body)
    3. upward_ray_link     — 위쪽 ray 센서, 0~50m

  Gazebo 토픽:
    /arms_drone/upward_camera/image   (gz.msgs.Image)
    /arms_drone/upward_ray/scan       (gz.msgs.LaserScan)
-->
<sdf version="1.9">
  <model name="arms_drone">

    <!-- PX4 내장 x500 그대로 사용 (x500_base 포함) -->
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <!-- ================================================================
         ARMS 커스텀 동체 메시 (SolidWorks STL)
         scale 0.003: mm→m / roll -90°: Y-up→Z-up / yaw 45°: 정면 보정
         ================================================================ -->
    <link name="base_link">
      <visual name="arms_body_visual">
        <pose>0 0 0.1 -1.5708 0 0.7854</pose>
        <geometry>
          <mesh>
            <scale>0.003 0.003 0.003</scale>
            <uri>model://arms_drone/meshes/ver_ksh_assembly.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.35 0.1 1</ambient>
          <diffuse>0.15 0.55 0.15 1</diffuse>
          <specular>0.2 0.3 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- ================================================================
         Upward-facing camera
         pitch = -pi/2 → optical axis points to +Z (sky) in body frame
         ================================================================ -->
    <link name="upward_camera_link">
      <pose relative_to="base_link">0 0 1.0 0 -1.5708 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="upward_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <topic>/arms_drone/upward_camera/image</topic>
      </sensor>
    </link>

    <joint name="upward_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>upward_camera_link</child>
    </joint>

    <!-- ================================================================
         Upward-facing ray sensor (distance to objects above)
         pitch = -pi/2 → ray points to +Z (sky)
         ================================================================ -->
    <link name="upward_ray_link">
      <pose relative_to="base_link">0 0 1.0 0 -1.5708 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia><ixx>1e-7</ixx><iyy>1e-7</iyy><izz>1e-7</izz></inertia>
      </inertial>
      <sensor name="upward_ray" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>8</samples>
              <min_angle>-0.26</min_angle>
              <max_angle>0.26</max_angle>
            </horizontal>
            <vertical>
              <samples>8</samples>
              <min_angle>-0.26</min_angle>
              <max_angle>0.26</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>50.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <topic>/arms_drone/upward_ray/scan</topic>
      </sensor>
    </link>

    <joint name="upward_ray_joint" type="fixed">
      <parent>base_link</parent>
      <child>upward_ray_link</child>
    </joint>

  </model>
</sdf>
