# ============================================================
# A.R.M.S. Detection Container — Laptop (x86, CPU or CUDA)
# Base: ros:jazzy (Ubuntu 24.04 Noble) — laptop host와 DDS 직렬화 버전을 맞춘다.
# Model: YOLOv11 .pt (PyTorch)
#
# Build context: arms_ws/src/
#   docker compose -f docker-compose.laptop.yml up --build
# ============================================================
FROM ros:jazzy

# Ubuntu 24.04의 PEP 668 보호는 격리된 컨테이너 안에서만 해제한다.
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# ---- ROS2 추가 패키지 ----
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-sensor-msgs \
        ros-jazzy-rosidl-default-generators \
        ros-jazzy-rosidl-default-runtime \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ---- ML 패키지 (pip) ----
# GPU가 없는 노트북에서 PyPI 기본 torch를 설치하면 CUDA/Triton까지 수 GB가
# 따라온다. CPU 전용 index를 먼저 사용해 이미지 크기와 최초 빌드 시간을 줄인다.
RUN pip3 install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.5.1 torchvision==0.20.1

# Noble의 Debian NumPy 위에 컨테이너 전용 wheel만 먼저 덮어 쓴다.
# 이후 일반 설치는 이미 설치된 CPU torch를 인식하므로 CUDA torch를 받지 않는다.
RUN pip3 install --no-cache-dir --ignore-installed numpy==2.2.6
RUN pip3 install --no-cache-dir ultralytics

RUN pip3 install --no-cache-dir --force-reinstall opencv-python-headless

# ---- Build arms_msgs inside the container ----
WORKDIR /ros_ws/src
COPY arms_msgs/ arms_msgs/

WORKDIR /ros_ws
RUN bash -c "source /opt/ros/jazzy/setup.bash && \
    colcon build --packages-select arms_msgs --cmake-args -DCMAKE_BUILD_TYPE=Release"

# opencv 는 위(opencv-python-headless)로 충분하다. 검출 노드가 쓰는 cv2 기능
# (KalmanFilter·cvtColor·findContours·Laplacian·imdecode 등)은 전부 core 라 contrib
# 불필요. (CSRT/KCF 트래커는 KF 필터로 대체되어 더 이상 안 씀.)

# ---- Copy detection node (HSV proposals + ROI YOLO, KF filter) ----
# YOLO 는 in-process (ARMS_MODEL 로 로드).
COPY arms_detection/arms_detection/arms_detection_node.py /ros_ws/arms_detection_node.py

# ---- Entry point ----
CMD ["bash", "-c", \
    "source /opt/ros/jazzy/setup.bash && \
     source /ros_ws/install/setup.bash && \
     python3 /ros_ws/arms_detection_node.py"]
