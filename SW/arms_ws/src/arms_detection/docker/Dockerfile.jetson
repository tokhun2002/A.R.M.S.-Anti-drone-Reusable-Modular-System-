# ============================================================
# A.R.M.S. Detection Container — Jetson (JetPack 6)
# Base: Ultralytics Jetson Jetpack6 (Ubuntu 22.04 + CUDA + ultralytics)
# Adds: ROS2 Humble + arms_msgs + detection node
#
# Build context: arms_ws/src/
#   docker compose -f docker-compose.jetson.yml up --build
# ============================================================
FROM ultralytics/ultralytics:latest-jetson-jetpack6

# ---- ROS2 Humble repository ----
# 'universe' repo must be enabled: several transitive deps of the ros-humble-*
# packages live there (official ROS 2 Humble install prerequisite).
# DEBIAN_FRONTEND=noninteractive prevents tzdata (pulled in by
# software-properties-common) from blocking the build on an interactive prompt.
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg lsb-release software-properties-common \
    && add-apt-repository -y universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) \
        signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        python3-dev \
        ros-humble-rclpy \
        ros-humble-sensor-msgs \
        ros-humble-rosidl-default-generators \
        ros-humble-rosidl-default-runtime \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# ---- Build arms_msgs inside the container ----
# Build context is arms_ws/src/, so arms_msgs/ is available at COPY time.
WORKDIR /ros_ws/src
COPY arms_msgs/ arms_msgs/

WORKDIR /ros_ws
RUN bash -c "source /opt/ros/humble/setup.bash && \
    colcon build --packages-select arms_msgs --cmake-args -DCMAKE_BUILD_TYPE=Release"

# ---- opencv tracking(contrib) 모듈 ----
# detect-then-track(CSRT/KCF) 는 opencv 의 tracking(contrib) 모듈이 필요.
# base 의 opencv-python 을 같은 버전의 contrib-headless 로 교체(호환 유지, GUI deps 제외).
# 검출 노드는 cv2 CUDA 를 안 쓰므로 headless 로 충분.
# cv2.__version__ 은 3자리(예: 4.11.0)지만 PyPI 휠은 4자리(4.11.0.86)라 ==4.11.0 은
# 안 맞음. ==4.11.0.* 로 같은 patch 의 최신 build 를, 실패 시 4.11.* 로 폴백(모두 동일
# major.minor 유지 → numpy/ultralytics 호환 보존, 최신으로 튀지 않음).
RUN CV_VER="$(python3 -c 'import cv2; print(cv2.__version__)' 2>/dev/null | cut -d- -f1)"; \
    MM="$(echo "$CV_VER" | cut -d. -f1,2)"; \
    pip3 uninstall -y opencv-python opencv-python-headless opencv-contrib-python 2>/dev/null || true; \
    if [ -n "$CV_VER" ]; then \
        pip3 install --no-cache-dir "opencv-contrib-python-headless==${CV_VER}.*" \
        || pip3 install --no-cache-dir "opencv-contrib-python-headless==${MM}.*"; \
    else \
        pip3 install --no-cache-dir opencv-contrib-python-headless; \
    fi \
    && python3 -c "import cv2; assert hasattr(cv2,'TrackerCSRT_create') or (hasattr(cv2,'legacy') and hasattr(cv2.legacy,'TrackerCSRT_create')), 'no tracking module'; print('opencv tracking OK', cv2.__version__)"

# ---- Copy detection node (HSV proposals + ROI YOLO + detect-then-track) ----
# YOLO 는 in-process (ARMS_MODEL 로 로드).
COPY arms_detection/arms_detection/arms_detection_node.py /ros_ws/arms_detection_node.py

# ---- Entry point ----
CMD ["bash", "-c", \
    "source /opt/ros/humble/setup.bash && \
     source /ros_ws/install/setup.bash && \
     python3 /ros_ws/arms_detection_node.py"]
