<?xml version="1.0"?>
<package format="3">
  <name>arms_control</name>
  <version>0.1.0</version>
  <description>State machine, PID control, and MAVLink interface for A.R.M.S. (C++).</description>
  <maintainer email="dev@arms.local">arms</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>arms_msgs</depend>

  <!-- MAVSDK: install via https://mavsdk.mavlink.io or apt -->
  <!-- sudo apt install libmavsdk-dev -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
