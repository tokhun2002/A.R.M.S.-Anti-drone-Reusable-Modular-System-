[Unit]
Description=A.R.M.S. real-drone autostart (ros2 launch arms_bringup arms.launch.py)
# 데스크톱(그래픽 세션)·도커·네트워크가 준비된 뒤 시작.
After=graphical.target docker.service network-online.target
Wants=docker.service

[Service]
Type=simple
User=arms
Group=arms

# arms_ui(OpenCV 창)가 실기체 모니터에 뜨도록 X 디스플레이 지정.
#   이 기기: X11 세션, Xorg 가 vt2/DISPLAY=:1, auth 는 GDM 관리 경로.
#   (확인: `ls /tmp/.X11-unix` 로 소켓 번호, `ps -e -o cmd|grep Xorg` 로 -auth 경로)
#   ★ ~/.Xauthority 는 없음 — GDM 은 /run/user/<uid>/gdm/Xauthority 를 씀.
Environment=DISPLAY=:1
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
Environment=ROS_DOMAIN_ID=0

ExecStart=/home/arms/A.R.M.S.-Anti-drone-Reusable-Modular-System-/SW/startup/start_arms.sh

# 죽으면 재시작 (스크립트가 장치/도커 준비를 대기하므로 시작 타임아웃 여유).
Restart=on-failure
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=graphical.target
